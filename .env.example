# Copy to ignored .env and load through your existing secure environment workflow.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Companion model credentials (one provider). Never used by seed generation.
LLM_PROVIDER=openai
LLM_MODEL=
OPENAI_API_KEY=
# Existing model connection configured in the Langfuse project for managed judges.
LANGFUSE_EVAL_PROVIDER=
LANGFUSE_EVAL_MODEL=
