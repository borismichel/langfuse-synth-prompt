# Copy to ignored .env and load through your existing secure environment workflow.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Provider key enables companion calls and optional Langfuse connection setup.
# Historical fixture generation remains model-free.
LLM_PROVIDER=anthropic
# Native experiment default. Companion role models are selected independently:
# PR-01 uses claude-sonnet-5-5; PR-02 and PR-03 use claude-opus-5-5.
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# Named Langfuse connection for managed judges. Setup/seed creates it if absent
# and a compatible provider key is available; existing credentials are preserved.
LANGFUSE_EVAL_PROVIDER=anthropic
LANGFUSE_EVAL_MODEL=claude-sonnet-5-5
