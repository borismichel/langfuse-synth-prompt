# Copy to ignored .env and load through your existing secure environment workflow.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Companion provider credentials. Never used by seed generation.
LLM_PROVIDER=anthropic
# Native experiment default. Companion role models are selected independently:
# PR-01 uses claude-sonnet-5-5; PR-02 and PR-03 use claude-opus-5-5.
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# Existing model connection configured in the Langfuse project for managed judges.
LANGFUSE_EVAL_PROVIDER=anthropic
LANGFUSE_EVAL_MODEL=claude-sonnet-5-5
